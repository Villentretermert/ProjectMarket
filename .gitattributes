# Preserve exported artifacts byte for byte, including ASCII-encoded PDF streams.
*.pdf binary
*.pptx binary
*.png binary
*.jpg binary
*.webp binary

# Source evidence hashes bind exact JSON bytes across Windows/Linux checkouts.
third_party/**/inventory.json text eol=lf
third_party/**/sources.json text eol=lf

# Preserve Cargo source evidence bytes exactly.
third_party/embedded-68958f1/locks/* -text

# Keep upstream signatures, keys and compressed source indexes byte exact.
third_party/debian-68958f1/metadata/* -text
third_party/debian-68958f1/manifest.json text eol=lf
third_party/delivery-68958f1/recipe.json text eol=lf

third_party/**/binding.json text eol=lf
