FROM python:3.14.9-slim-bookworm@sha256:945c2676dc2b18e0c1f16879244122c57c0ffede60006bf3df159c507a31bcae AS python-base
# Keep the bot's TLS client and build tooling on the same security backport.
RUN apt-get update \
    && apt-get install -y --only-upgrade --no-install-recommends \
       libssl3=3.0.22-1~deb12u2 openssl=3.0.22-1~deb12u2 \
    && rm -rf /var/lib/apt/lists/*

FROM python-base AS build
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
RUN pip install --no-cache-dir uv==0.13.5
COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY packages/contracts/pyproject.toml packages/contracts/pyproject.toml
COPY packages/bot-sdk/pyproject.toml packages/bot-sdk/pyproject.toml
COPY bots/pilot/pyproject.toml bots/pilot/pyproject.toml
COPY packages/contracts/src/contracts/__init__.py packages/contracts/src/contracts/schemas.json packages/contracts/src/contracts/
COPY packages/bot-sdk/src/ packages/bot-sdk/src/
COPY bots/pilot/src/ bots/pilot/src/
RUN uv sync --locked --package marketob-demo-bots --no-dev --no-editable

FROM python-base
WORKDIR /app
# The copied virtualenv is complete; keep build tooling out of the running bot.
RUN python -m pip uninstall --yes pip
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN groupadd --gid 10001 marketob && useradd --uid 10001 --gid marketob --no-create-home marketob \
    && mkdir /data && chown 10001:10001 /data
COPY --from=build --chown=10001:10001 /app/.venv /app/.venv
USER 10001:10001
CMD ["python", "-m", "marketob_bots.catalog"]
