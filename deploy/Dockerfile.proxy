FROM caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
# We bind 8443, so remove the upstream privileged-port file capability before cap_drop=ALL.
RUN setcap -r /usr/bin/caddy && mkdir -p /data/caddy /config/caddy && chown -R 10001:10001 /data /config
COPY deploy/Caddyfile /etc/caddy/Caddyfile
USER 10001:10001
EXPOSE 8443
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=6 \
  CMD wget --spider --quiet --no-check-certificate https://localhost:8443/health/ready || exit 1
