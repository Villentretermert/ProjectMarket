<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_title" android:textColor="#174B87" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_headline_one" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="#223348" android:textSize="15sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_headline_two" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#223348" android:textSize="15sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="#53667D" android:textSize="11sp" />
</LinearLayout>
