# Optional for direct Python startup. No secrets are needed for unit tests.
MARKETOB_HOST=127.0.0.1
MARKETOB_PORT=8000
MARKETOB_LOG_LEVEL=info
MARKETOB_DATABASE_TIMEOUT_SECONDS=3
# For direct Python + an existing PostgreSQL, set a real local URL in .env:
# MARKETOB_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Compose requires a generated local password; run python scripts/dev_env.py.
# Do not use this blank value as a password or commit the generated .env.
POSTGRES_PASSWORD=

# Exact UI origins; plain HTTP is allowed only on loopback.
MARKETOB_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
MARKETOB_SESSION_HOURS=24
MARKETOB_AUTH_RATE_LIMIT=10

# Docker delivery: keep the same tag when testing rollback; DB name can point to a new restore.
MARKETOB_DB_NAME=marketob
MARKETOB_RELEASE=local
# With deploy/compose.local.yaml include https://localhost:8443 in MARKETOB_ALLOWED_ORIGINS.
